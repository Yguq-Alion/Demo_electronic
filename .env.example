# Ключ LLM API. Обязательно. Никогда не коммитить (.env в .gitignore).
LLM_API_KEY=sk-...

# OpenAI-совместимый эндпоинт. По умолчанию — официальный OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Примеры для других провайдеров (раскомментировать нужное):
# Z.ai (GLM Coding Plan):      LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
#                              LLM_MODEL=glm-5.3-flash
# Z.ai (обычный ключ API):     LLM_BASE_URL=https://api.z.ai/api/paas/v4
# OpenRouter:                  LLM_BASE_URL=https://openrouter.ai/api/v1
#                              LLM_MODEL=openai/gpt-4o-mini
# Локальная модель (Ollama):   LLM_BASE_URL=http://localhost:11434/v1
#                              LLM_MODEL=qwen2.5:7b  (LLM_API_KEY=ollama)

LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16000
